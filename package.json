{
  "name": "a11y-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Accessibility SDLC control plane: AQA (UsableNet) coverage + Cursor Background Agents for fixes",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node --env-file=.env server/index.mjs",
    "start:demo": "node server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
