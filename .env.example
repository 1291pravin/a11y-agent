# A11y Agent — copy to .env and fill in values.
# Sourced from filorga-fr / filorga-eu AI OS configuration.

PORT=4173
# If PORT is in use, the server tries the next port (4174, 4175, …). Set PORT_STRICT=1 to fail instead.

# UsableNet AQA (real mode when both are set)
# filorga projects use AQA_TEAM_SLUG; this repo expects AQA_TEAMSLUG (no underscore).
AQA_TEAMSLUG=colgate
# Quote the value — the key contains shell-special characters (^ | # ? +)
AQA_API_KEY=""
# Optional: override the AQA API base URL (tests point this at a local mock)
# AQA_BASE=https://api-aqa.usablenet.com/v3.1
# Optional: ruleset for journey / quick-scan evaluate (pack v2 ids from GET /a11y/tests/rulesets)
# AQA_RULESET_PACK_ID=v2
# AQA_RULESET_ID=wcag21_needfix_1

# Cursor Cloud Agents API (optional — demo mode when unset)
CURSOR_API_KEY=
# Dispatch backend: auto (default) | cloud | cli
# auto = cloud when CURSOR_API_KEY is set; on cloud launch failure (or when
# no key), fall back to the local Cursor Agent CLI if site.repoPath is set.
# cli  = always use the local agent CLI (needs `agent` on PATH + repoPath)
# cloud = cloud only (current behavior, no CLI fallback)
# CURSOR_MODE=auto
# Optional: path to the Cursor Agent CLI binary (default: `agent` on PATH,
# then ~/.local/bin/agent). Install with: curl https://cursor.com/install -fsS | bash
# CURSOR_CLI_BIN=
# CURSOR_CLI_MODEL=composer-2.5
# CURSOR_CLI_DIR=data/cursor-cli
# Optional: auto-retry transient launch failures (default 3 attempts, 5s apart)
# CURSOR_LAUNCH_RETRIES=3
# CURSOR_LAUNCH_RETRY_MS=5000
# Optional: poll interval / deadline for in-flight cursor runs
# CURSOR_POLL_MS=15000
# CURSOR_POLL_DEADLINE_MS=1800000
# Filorga fleet — bootstrapped from AQA on startup (replaces demo data)
# JSON array: id, url, repo, suiteId, testId (optional), framework (optional)
FLEET_SITES=[{"id":"filorga-fr","url":"https://fr.filorga.com","repo":"colpal/filorga-fr","suiteId":"TS31223","testId":"A183406-0","framework":"Shopify + Vue 3"},{"id":"filorga-eu","url":"https://dev.int.filorga.com","repo":"colpal/filorga-eu","suiteId":"TS24575","testId":"A206322-0","framework":"Shopify + Vue 3"},{"id":"filorga-intl-dev","url":"https://dev.int.filorga.com","repo":"colpal/filorga-eu","suiteId":"TS35353","testId":"A206102-0","framework":"Shopify + Vue 3"}]

# Set USE_DEMO_DATA=1 to force the small demo seed even when AQA creds are present

# ── M5 fleet hardening (all optional) ──
# Shared admin token: when set, every non-GET /api/* call needs
# "authorization: Bearer <token>" (the GitHub webhook keeps its HMAC auth).
# ADMIN_TOKEN=
# Staggered weekly scans (real AQA only): each site gets a stable Mon-Thu
# 01:00-05:00 UTC slot; a 10-min tick kicks due scans one at a time.
# SCHEDULE_ENABLED=1
# SCHEDULE_TICK_MS=600000
# Persistence: SQLite (node:sqlite, Node 22.5+) is used automatically when
# available; STATE_DB moves the DB file, STORE_BACKEND=json forces the JSON
# file store (data/state.json). STATE_FILE always implies the JSON backend.
# STATE_DB=data/state.db
# STORE_BACKEND=json
# AQA rate budget: max requests per sliding window (polling + retries count).
# AQA_MAX_RPM=60
# AQA_RATE_WINDOW_MS=60000

# ── Journey runner (evaluate path, all optional) ──
# The runner is a separate process (npm run runner) that owns Chromium. It reads
# the same AQA credentials as the control plane and carries its OWN rate budget.
# Where the control plane looks for it:
# RUNNER_URL=http://localhost:4174
# How the runner listens. Loopback by default: /run drives a real browser at any
# URL it is handed, so do not bind it to a shared interface without meaning to.
# RUNNER_PORT=4174
# If RUNNER_PORT is in use, tries the next port; set RUNNER_PORT_STRICT=1 to fail instead.
# RUNNER_HOST=127.0.0.1
# How long the control plane waits for a whole journey, and each step.
# RUNNER_TIMEOUT_MS=300000
# RUNNER_STEP_TIMEOUT_MS=15000
# Override to pin a local copy of the vendor DOM analyzer.
# AQA_ANALYZER_URL=https://aqa.usablenet.com/aqapool/js/aqa-analyzer.js

# Issue triage after AQA fetch (deterministic merge always; optional LLM pass)
# TRIAGE_MAX_CAUSES=15
# TRIAGE_LLM=1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE=https://api.openai.com/v1
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Autopilot (M6-M9) ──
# M7: where the runner writes dry-run/journey screenshots (must be shared with
# the control plane process; both are on the same host in all supported
# deployments). Default: <repo>/data/screenshots
# SCREENSHOT_DIR=

# M9: Fix All batch dispatch caps. Concurrency is the max in-flight tasks per
# batch; budget stops the run when the estimated spend exceeds this dollar
# ceiling. Per-task cost is a rough heuristic (Cursor does not report cost),
# override if your org has a tighter estimate.
# FIXRUN_CONCURRENCY=3
# FIXRUN_BUDGET_USD=25
# FIXRUN_TASK_COST_USD=0.75
# FIXRUN_ADVANCE_MS=3000
