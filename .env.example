# A11y Agent — copy to .env and fill in values.
# Sourced from filorga-fr / filorga-eu AI OS configuration.

PORT=4173

# UsableNet AQA (real mode when both are set)
# filorga projects use AQA_TEAM_SLUG; this repo expects AQA_TEAMSLUG (no underscore).
AQA_TEAMSLUG=colgate
# Quote the value — the key contains shell-special characters (^ | # ? +)
AQA_API_KEY=""
# Optional: override the AQA API base URL (tests point this at a local mock)
# AQA_BASE=https://api-aqa.usablenet.com/v3.1
# Optional: scan poll interval in ms (default 10000, ~10 min timeout)
# AQA_POLL_MS=10000

# Cursor Cloud Agents API (optional — demo mode when unset)
CURSOR_API_KEY=
# Filorga fleet — bootstrapped from AQA on startup (replaces demo data)
# JSON array: id, url, repo, suiteId, testId (optional), framework (optional)
FLEET_SITES=[{"id":"filorga-fr","url":"https://fr.filorga.com","repo":"colpal/filorga-fr","suiteId":"TS31223","testId":"A183406-0","framework":"Shopify + Vue 3"},{"id":"filorga-eu","url":"https://dev.int.filorga.com","repo":"colpal/filorga-eu","suiteId":"TS24575","testId":"A206322-0","framework":"Shopify + Vue 3"},{"id":"filorga-intl-dev","url":"https://dev.int.filorga.com","repo":"colpal/filorga-eu","suiteId":"TS35353","testId":"A206102-0","framework":"Shopify + Vue 3"}]

# Set USE_DEMO_DATA=1 to force the small demo seed even when AQA creds are present
